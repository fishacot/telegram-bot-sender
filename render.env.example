# Скопируйте в render.env.local и заполните. Не коммитьте секреты в git.

BOT_TOKEN=123456:ABC...
ADMIN_IDS=123456789
TELEGRAM_API_ID=2040
TELEGRAM_API_HASH=your_api_hash

# Render: данные на диске контейнера (переживают рестарт, но не полный redeploy)
DATABASE_URL=sqlite+aiosqlite:////data/app.db
SESSIONS_DIR=/data/sessions

LOG_LEVEL=INFO
LOG_JSON=true
AI_AGENT_ENABLED=true
AI_PROVIDER=stub
AGENT_NOTIFY_ON_ERROR=false

# Опционально: Bot API из РФ (socks5)
# TELEGRAM_PROXY=socks5://user:pass@host:1080
